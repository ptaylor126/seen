{
  "expo": {
    "name": "Seen",
    "slug": "seen",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "seen",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f5b6bf67-e85d-4d40-b863-62fd4cbef79e"
    },
    "ios": {
      "bundleIdentifier": "com.paultaylor.seen",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:seenrecs.com"],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.paultaylor.seen",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "seenrecs.com", "pathPrefix": "/i/" },
            { "scheme": "https", "host": "seenrecs.com", "path": "/i" },
            { "scheme": "https", "host": "seenrecs.com", "pathPrefix": "/r/" },
            { "scheme": "https", "host": "seenrecs.com", "path": "/r" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0B0D26",
          "android": {
            "image": "./assets/images/android-splash-blank.png",
            "imageWidth": 240,
            "resizeMode": "contain",
            "backgroundColor": "#0B0D26"
          }
        }
      ],
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.555711294328-a8bq6p5ot1nrpinkdr5k99c5u7en7ntn"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7A3960",
          "defaultChannel": "default"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Seen needs access to your photos to set your profile picture and attach screenshots to feedback.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5b6bf67-e85d-4d40-b863-62fd4cbef79e"
      }
    }
  }
}
